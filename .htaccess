<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve Everything From The Public Folder...
    # (uploaded photos under /storage are handed out by the app, see StoredPhotoController)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Never Expose The Project Files (.env, storage, vendor)...
    Require all denied
</IfModule>
